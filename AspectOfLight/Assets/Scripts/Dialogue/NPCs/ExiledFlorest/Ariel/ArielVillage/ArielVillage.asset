MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b844faeac500ba845939da53eaad3b15, type: 3}
  m_Name: ArielVillage
  m_EditorClassIdentifier: 
  speakerName: Ariel
  dialogueNodes:
  - dialogueText: I'll assume you're not a threat and I won't harm you, b- but you
      better be careful about what you do be-because I'm keeping an eye on you...!
    dialogueChoises: []
  - dialogueText: 'Well... Welcome to the Village!! '
    dialogueChoises: []
  - dialogueText: This is, well, the Village!!
    dialogueChoises: []
  - dialogueText: Land of the Engineer and land of great story... I was born and
      raised here, so everything I know is here, which is why I think it's a beautiful
      village.
    dialogueChoises: []
  - dialogueText: So tell me, can I help you with something traveller?
    dialogueChoises:
    - choiseText: Land of the Engineer?
      choiseIndex: 0
      followOnDialogue: {fileID: 11400000, guid: e3a1bec32547167499178341d018f726, type: 2}
      choiseWasAlreadyChoosen: 1
    - choiseText: Have you never left the village?
      choiseIndex: 1
      followOnDialogue: {fileID: 11400000, guid: 707b74a1303c16840a4fe3e9ad542bd6, type: 2}
      choiseWasAlreadyChoosen: 0
    - choiseText: Where should I go?
      choiseIndex: 2
      followOnDialogue: {fileID: 11400000, guid: 39b08edcee882604e8469064217136b6, type: 2}
      choiseWasAlreadyChoosen: 0
    - choiseText: I have to go...
      choiseIndex: 3
      followOnDialogue: {fileID: 11400000, guid: 21ca995501d16fb4496c5fe1d92a5c9a, type: 2}
      choiseWasAlreadyChoosen: 0
  followOnDialogue: {fileID: 0}
  startFollowOnDialogueIndex: 0
