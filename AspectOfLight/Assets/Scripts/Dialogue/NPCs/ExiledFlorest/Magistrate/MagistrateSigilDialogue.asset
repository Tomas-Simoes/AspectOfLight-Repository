  speakerName: ???
  dialogueNodes:
  - dialogueText: There it lies. You'll find several of these as you walk along your
      path. If you decide to enter, know that I will be there to heal your injured
      wounds and bless you with powerful abilities.
    dialogueChoises: []
  - dialogueText: These will help you in your objective. They were once owned  by
      powerful humans and now I'm willing to give them to you in return for Miracles.
    dialogueChoises: []
  - dialogueText: Miracles help me strengthen our bond and make you stronger. Find
      them by staying on the right path. I believe in your ability to succeed.
    dialogueChoises:
    - choiseText: Who are you?
      choiseIndex: 0
      followOnDialogue: {fileID: 0}
      choiseWasAlreadyChoosen: 1
      onlyReadbleOnce: 0
  followOnDialogue: {fileID: 0}
  startFollowOnDialogueIndex: 0
