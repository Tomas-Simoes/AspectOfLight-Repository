  m_Script: {fileID: 11500000, guid: b844faeac500ba845939da53eaad3b15, type: 3}
  m_Name: ArialFirstInteraction
  m_EditorClassIdentifier: 
  speakerName: 
  dialogueNodes:
  - dialogueText: Hey!! Stop right there! Not one more step or I... I... I'll attack!!
    dialogueChoises: []
  - dialogueText: I warned you! Not o- on- one more step!!
    dialogueChoises: []
  - dialogueText: OK OK DON'T ATTACK ME PLEASE!!
    dialogueChoises: []
  - dialogueText: SORRY SORRY, PLEASE FORGIVE ME!!
    dialogueChoises: []
  - dialogueText: OK... I'll let you pass, you can go, go ahead, you can pass freely...
    dialogueChoises: []
  - dialogueText: Hey... Ahm... By any chance do you mind if I follow you? I really
      should do my job and not let any creatures into *name of the village*.
    dialogueChoises: []
  - dialogueText: I wasn't expecting to find a person coming out of there... but
      I should really go with you just to avoid any problems
    dialogueChoises: []
  followOnDialogue: {fileID: 0}
